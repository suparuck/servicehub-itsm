# ใช้เมื่อรันนอก Docker (npm run dev บนเครื่อง) — ใน docker compose ตั้งค่าไว้แล้ว
DATABASE_URL="postgresql://servicehub:servicehub@localhost:5432/servicehub?schema=public"

# ── Auth.js ───────────────────────────────────────────────
# ความลับสำหรับเซ็น session — ต้องสุ่มเอง: openssl rand -base64 32
AUTH_SECRET=""
# รหัสผ่านบัญชีตัวอย่างตอน seed (ต้องกำหนดเองเมื่อ NODE_ENV=production)
SEED_PASSWORD=""

# ── Microsoft Entra ID (Azure AD) — ไม่บังคับ ─────────────
# กำหนดครบทั้ง 3 ค่าเพื่อเปิดปุ่ม "เข้าสู่ระบบด้วย Microsoft" · Redirect URI: <url>/api/auth/callback/microsoft-entra-id
# ISSUER รูปแบบ https://login.microsoftonline.com/<tenant-id>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""

# ── โดเมนสาธารณะ (ตั้งตอน deploy หลัง reverse proxy) ───────
# URL ที่ผู้ใช้เปิดจริง เช่น https://itsm.example.com — ใช้สร้างลิงก์ redirect ของ middleware/Auth.js
# ถ้าไม่ตั้ง จะใช้ X-Forwarded-Proto/Host (proxy ต้องส่ง header นี้และต้องเชื่อถือได้) แล้วถอยไปใช้ Host
AUTH_URL=""
