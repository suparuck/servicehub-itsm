// ServiceHub — โมเดลข้อมูลตามแนวปฏิบัติ ITIL 4
// เลขที่เอกสาร (INC-#####, REQ-#####, ...) = sequence ใน DB (คอลัมน์ seq) จัดรูปแบบใน src/lib/docno.ts
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  END_USER
  AGENT
  RESOLVER_GROUP_LEAD
  CHANGE_MANAGER
  CAB_MEMBER
  CONFIG_MANAGER
  ADMIN
}

enum Level {
  HIGH
  MED
  LOW
}

enum Priority {
  P1
  P2
  P3
  P4
}

enum IncidentStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  PENDING_USER
  PENDING_VENDOR
  RESOLVED
  CLOSED
}

enum ServiceHealth {
  OK
  DEGRADED
  DOWN
}

enum CiClass {
  BUSINESS_SERVICE
  APPLICATION
  SERVER
  DATABASE
  NETWORK_DEVICE
  CLOUD_RESOURCE
  END_USER_DEVICE
  SOFTWARE_LICENSE
}

enum CiLifecycle {
  PLANNED
  LIVE
  MAINTENANCE
  RETIRED
}

enum RelationType {
  DEPENDS_ON
  RUNS_ON
  CONNECTS_TO
  HOSTS
}

enum RequestStatus {
  SUBMITTED
  PENDING_APPROVAL
  FULFILLING
  DELIVERED
  REJECTED
  CANCELLED
}

enum ProblemPhase {
  IDENTIFICATION
  CONTROL
  ERROR_CONTROL
  KNOWN_ERROR
  RESOLVED
}

enum ChangeType {
  STANDARD
  NORMAL
  EMERGENCY
}

enum ChangeStatus {
  DRAFT
  AWAITING_APPROVAL
  APPROVED
  SCHEDULED
  IMPLEMENTING
  COMPLETED
  FAILED
  CANCELLED
}

enum RiskLevel {
  HIGH
  MED
  LOW
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

enum NoteVisibility {
  INTERNAL
  CUSTOMER
}

enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
}

enum SlaMetric {
  RESPONSE
  RESOLVE
}

enum SlaTimerState {
  RUNNING
  PAUSED
  MET
  BREACHED
}

model User {
  id                 String           @id @default(cuid())
  email              String           @unique
  name               String
  initials           String
  role               Role             @default(END_USER)
  groupId            String?
  group              AssignmentGroup? @relation(fields: [groupId], references: [id])
  passwordHash       String? // bcrypt — ว่างได้สำหรับผู้ใช้ที่ล็อกอินผ่าน Entra ID เท่านั้น
  active             Boolean          @default(true)
  lastLoginAt        DateTime?
  mustChangePassword Boolean          @default(false) // รหัสผ่านชั่วคราวจากผู้ดูแล → ต้องเปลี่ยนก่อนใช้งาน
  passwordChangedAt  DateTime? // session ที่ออกก่อนเวลานี้ใช้ไม่ได้
  notifyAssigned     Boolean          @default(true) // งานที่มอบหมายให้ฉัน / ผู้ใช้ตอบกลับเรื่องของฉัน
  notifyCritical     Boolean          @default(true) // P1 / Major Incident
  notifyMyItems      Boolean          @default(true) // ความคืบหน้าของเรื่องที่ฉันแจ้งหรือขอ
  notifyApprovals    Boolean          @default(true) // มีคำขออนุมัติ Change / คำขอบริการ
  notifySla          Boolean          @default(true) // SLA ใกล้ผิด / ผิด
  notifyAssets       Boolean          @default(true) // ประกัน/ไลเซนส์ใกล้หมด · ไลเซนส์ใช้เกินสิทธิ์
  createdAt          DateTime         @default(now())

  assignedIncidents Incident[]           @relation("IncidentAssignee")
  managedIncidents  Incident[]           @relation("IncidentManager")
  reportedIncidents Incident[]           @relation("IncidentReporter")
  requests          ServiceRequest[]
  notes             WorkNote[]
  ownedCis          ConfigurationItem[]  @relation("CiOwnerUser")
  surveys           SurveyResponse[]
  changeApprovals   ChangeApproval[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  assetsHeld        Asset[]              @relation("AssetAssignee")
  improvementsOwned ImprovementItem[]    @relation("ImprovementOwner")
  assignmentRules   AssignmentRule[]     @relation("RuleAssignee")
  eventsAcked       MonitoringEvent[]    @relation("EventAckedBy")
  releasesOwned     Release[]            @relation("ReleaseOwner")
  resetTokens       PasswordResetToken[]
  changesRequested  Change[]             @relation("ChangeRequester")
}

model AssignmentGroup {
  id    String @id @default(cuid())
  name  String @unique
  users User[]

  incidents Incident[]
  cisOwned  ConfigurationItem[]
  rules     AssignmentRule[]
}

model Service {
  id           String            @id @default(cuid())
  code         String            @unique
  name         String
  fullName     String? // ชื่อเต็มที่ใช้ในคิว Incident เช่น "บริการ ERP"
  category     String?
  ownerName    String?
  health       ServiceHealth     @default(OK)
  sortOrder    Int               @default(0)
  slaId        String?
  sla          Sla?              @relation(fields: [slaId], references: [id])
  offerings    ServiceOffering[]
  incidents    Incident[]
  changes      Change[]
  catalogItems CatalogItem[]
  improvements ImprovementItem[]
  rules        AssignmentRule[]
  releases     Release[]
}

model ServiceOffering {
  id          String  @id @default(cuid())
  serviceId   String
  service     Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name        String
  description String?
}

model Sla {
  id       String      @id @default(cuid())
  name     String
  calendar String      @default("24x7")
  targets  SlaTarget[]
  services Service[]
}

model SlaTarget {
  id       String    @id @default(cuid())
  slaId    String
  sla      Sla       @relation(fields: [slaId], references: [id], onDelete: Cascade)
  priority Priority
  metric   SlaMetric
  minutes  Int

  @@unique([slaId, priority, metric])
}

model SlaTimer {
  id               String        @id @default(cuid())
  incidentId       String
  incident         Incident      @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  metric           SlaMetric
  startedAt        DateTime
  dueAt            DateTime
  targetMinutes    Int
  achievedAt       DateTime?
  pausedAt         DateTime?
  nearNotifiedAt   DateTime? // ส่งแจ้งเตือน "ใกล้ผิด SLA" แล้ว (ส่งครั้งเดียว)
  breachNotifiedAt DateTime? // ส่งแจ้งเตือน "ผิด SLA" แล้ว
  state            SlaTimerState @default(RUNNING)

  @@unique([incidentId, metric])
}

model ConfigurationItem {
  id               String           @id @default(cuid())
  ciId             String           @unique
  name             String
  subtitle         String?
  ciClass          CiClass
  classLabel       String?
  environment      String           @default("Prod")
  lifecycle        CiLifecycle      @default(LIVE)
  ownerGroupId     String?
  ownerGroup       AssignmentGroup? @relation(fields: [ownerGroupId], references: [id])
  ownerUserId      String?
  ownerUser        User?            @relation("CiOwnerUser", fields: [ownerUserId], references: [id])
  ownerLabel       String?
  attributes       Json             @default("{}")
  lastDiscoveredAt DateTime?
  lastVerifiedAt   DateTime?
  driftNote        String? // ข้อมูลไม่ตรงกับ Discovery (รอกระทบยอด)
  createdAt        DateTime         @default(now())

  outgoing  CIRelationship[]  @relation("RelSource")
  incoming  CIRelationship[]  @relation("RelTarget")
  incidents IncidentCI[]
  changes   ChangeCI[]
  asset     Asset?
  history   CIChangeLog[]
  events    MonitoringEvent[]

  @@index([ciClass])
  @@index([lifecycle])
}

model CIRelationship {
  id       String            @id @default(cuid())
  sourceId String
  source   ConfigurationItem @relation("RelSource", fields: [sourceId], references: [id], onDelete: Cascade)
  targetId String
  target   ConfigurationItem @relation("RelTarget", fields: [targetId], references: [id], onDelete: Cascade)
  type     RelationType

  @@unique([sourceId, targetId, type])
}

enum AssetStatus {
  ORDERED // สั่งซื้อแล้ว รอรับของ
  IN_STOCK // อยู่ในคลัง พร้อมจ่าย
  IN_USE // ใช้งานอยู่ (มีผู้ถือครองหรือติดตั้งใช้งานแล้ว)
  IN_REPAIR // ส่งซ่อม
  RETIRED // ปลดระวางแล้ว
}

model Asset {
  id           String            @id @default(cuid())
  assetTag     String            @unique
  ciId         String            @unique
  ci           ConfigurationItem @relation(fields: [ciId], references: [id], onDelete: Cascade)
  status       AssetStatus       @default(IN_USE)
  vendor       String?
  serialNo     String?
  location     String?
  costBaht     Int?
  purchasedAt  DateTime?
  supportUntil DateTime? // สิ้นสุดประกัน/สัญญา MA (ไลเซนส์ = วันหมดอายุไลเซนส์)
  licenseQty   Int? // ไลเซนส์: จำนวนสิทธิ์ที่ซื้อ
  licenseUsed  Int? // ไลเซนส์: จำนวนสิทธิ์ที่ใช้ไปแล้ว
  assignedToId String?
  assignedTo   User?             @relation("AssetAssignee", fields: [assignedToId], references: [id])
  assignedAt   DateTime?
  createdAt    DateTime          @default(now())

  @@index([status])
  @@index([assignedToId])
}

model Incident {
  id            String           @id @default(cuid())
  seq           Int              @unique @default(autoincrement()) // INC-#####
  title         String
  description   String?
  impact        Level
  urgency       Level
  priority      Priority
  status        IncidentStatus   @default(NEW)
  lifecycleStep Int              @default(1) // 1–5 บันทึก → จัดลำดับ → วินิจฉัย → แก้ไข → ปิด
  category      String?
  channel       String?
  isMajor       Boolean          @default(false)
  serviceId     String?
  service       Service?         @relation(fields: [serviceId], references: [id])
  groupId       String?
  group         AssignmentGroup? @relation(fields: [groupId], references: [id])
  assigneeId    String?
  assignee      User?            @relation("IncidentAssignee", fields: [assigneeId], references: [id])
  managerId     String?
  manager       User?            @relation("IncidentManager", fields: [managerId], references: [id])
  reporterId    String?
  reporter      User?            @relation("IncidentReporter", fields: [reporterId], references: [id])
  parentId      String?
  parent        Incident?        @relation("IncidentTree", fields: [parentId], references: [id])
  children      Incident[]       @relation("IncidentTree")
  problemId     String?
  problem       Problem?         @relation(fields: [problemId], references: [id])
  changeId      String?
  change        Change?          @relation(fields: [changeId], references: [id])
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  resolvedAt    DateTime?
  closedAt      DateTime?

  cis              IncidentCI[]
  notes            WorkNote[]
  timers           SlaTimer[]
  survey           SurveyResponse?
  monitoringEvents MonitoringEvent[]

  @@index([status, priority])
  @@index([serviceId])
}

model IncidentCI {
  incidentId String
  incident   Incident          @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  ciId       String
  ci         ConfigurationItem @relation(fields: [ciId], references: [id], onDelete: Cascade)
  role       String? // ได้รับผลกระทบ / ต้นเหตุที่เป็นไปได้ / ...

  @@id([incidentId, ciId])
}

model WorkNote {
  id          String         @id @default(cuid())
  incidentId  String
  incident    Incident       @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  authorId    String?
  author      User?          @relation(fields: [authorId], references: [id])
  authorLabel String?
  kind        String // การวินิจฉัย / สื่อสารผู้ใช้ / ยกระดับ / จัดประเภท / Event
  tone        String         @default("neutral") // accent | ok | critical | ink | muted
  visibility  NoteVisibility @default(INTERNAL)
  body        String
  createdAt   DateTime       @default(now())

  @@index([incidentId, createdAt])
}

model CatalogItem {
  id        String           @id @default(cuid())
  name      String
  items     String
  slaText   String
  serviceId String?
  service   Service?         @relation(fields: [serviceId], references: [id])
  sortOrder Int              @default(0)
  published Boolean          @default(true) // false = ซ่อนจากพอร์ทัล (ยังเก็บประวัติคำขอเดิมไว้)
  requests  ServiceRequest[]
}

model ServiceRequest {
  id          String           @id @default(cuid())
  seq         Int              @unique @default(autoincrement()) // REQ-#####
  title       String
  status      RequestStatus    @default(SUBMITTED)
  stage       Int              @default(1) // 1 ส่ง · 2 อนุมัติ · 3 จัดเตรียม · 4 ส่งมอบ
  nextNote    String?
  catalogId   String?
  catalog     CatalogItem?     @relation(fields: [catalogId], references: [id])
  requesterId String?
  requester   User?            @relation(fields: [requesterId], references: [id])
  description String?
  createdAt   DateTime         @default(now())
  deliveredAt DateTime?
  survey      SurveyResponse?
  approvals   ApprovalStep[]
  tasks       FulfilmentTask[]
}

model ApprovalStep {
  id        String         @id @default(cuid())
  requestId String
  request   ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  approver  String
  decision  String? // APPROVED / REJECTED
  decidedAt DateTime?
}

model FulfilmentTask {
  id        String         @id @default(cuid())
  requestId String
  request   ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  title     String
  done      Boolean        @default(false)
}

model Problem {
  id           String             @id @default(cuid())
  seq          Int                @unique @default(autoincrement()) // PRB-####
  title        String
  phase        ProblemPhase       @default(IDENTIFICATION)
  phaseLabel   String?
  description  String?
  rootCause    String?
  workaround   String?
  workNote     String? // ข้อความสรุปบนแดชบอร์ด
  resolvedAt   DateTime?
  targetDate   DateTime? // วันที่คาดว่าจะแก้ไข/ทบทวน — แสดงในปฏิทิน Change & Problem
  createdAt    DateTime           @default(now())
  incidents    Incident[]
  articles     KnowledgeArticle[]
  changes      Change[]
  improvements ImprovementItem[]
}

model Change {
  id                 String           @id @default(cuid())
  seq                Int              @unique @default(autoincrement()) // CHG-####
  title              String
  type               ChangeType
  risk               RiskLevel
  status             ChangeStatus     @default(DRAFT)
  windowStart        DateTime
  windowEnd          DateTime?
  serviceId          String?
  service            Service?         @relation(fields: [serviceId], references: [id])
  problemId          String?
  problem            Problem?         @relation(fields: [problemId], references: [id])
  description        String?
  implementationPlan String?
  backoutPlan        String?
  outcome            String?
  cabApproval        String? // CAB / ECAB
  completedAt        DateTime?
  requesterId        String?
  requester          User?            @relation("ChangeRequester", fields: [requesterId], references: [id])
  releaseId          String?
  release            Release?         @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  createdAt          DateTime         @default(now())
  cis                ChangeCI[]
  incidents          Incident[]
  approvals          ChangeApproval[]

  @@index([windowStart])
}

model ChangeCI {
  changeId String
  change   Change            @relation(fields: [changeId], references: [id], onDelete: Cascade)
  ciId     String
  ci       ConfigurationItem @relation(fields: [ciId], references: [id], onDelete: Cascade)

  @@id([changeId, ciId])
}

model KnowledgeArticle {
  id        String        @id @default(cuid())
  seq       Int           @unique @default(autoincrement()) // KB-####
  title     String
  body      String?
  status    ArticleStatus @default(PUBLISHED)
  views     Int           @default(0)
  problemId String?
  problem   Problem?      @relation(fields: [problemId], references: [id])
  updatedAt DateTime      @default(now()) @updatedAt
  createdAt DateTime      @default(now())
}

enum ImprovementStatus {
  OPEN // กำลังดำเนินการ
  ON_HOLD // พักไว้ชั่วคราว
  DONE // บรรลุเป้าหมายและปิดแล้ว
  CANCELLED // ยกเลิก
}

// ทะเบียนการปรับปรุงอย่างต่อเนื่อง — โมเดลปรับปรุง 7 ขั้นของ ITIL 4 (step 1–7)
model ImprovementItem {
  id          String            @id @default(cuid())
  seq         Int               @unique @default(autoincrement()) // IMP-####
  title       String
  step        Int // 1–7
  sortOrder   Int               @default(0)
  status      ImprovementStatus @default(OPEN)
  description String? // วิสัยทัศน์/เหตุผลที่ต้องปรับปรุง (ขั้น 1)
  baseline    String? // สถานะปัจจุบันที่วัดได้ (ขั้น 2)
  goal        String? // เป้าหมายที่วัดได้ (ขั้น 3)
  result      String? // ผลที่ได้จริง (ขั้น 6)
  benefit     Level             @default(MED)
  ownerId     String?
  owner       User?             @relation("ImprovementOwner", fields: [ownerId], references: [id])
  targetDate  DateTime?
  problemId   String?
  problem     Problem?          @relation(fields: [problemId], references: [id])
  serviceId   String?
  service     Service?          @relation(fields: [serviceId], references: [id])
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @default(now()) @updatedAt
  completedAt DateTime?

  @@index([status])
  @@index([ownerId])
}

model SurveyResponse {
  id         String          @id @default(cuid())
  incidentId String?         @unique
  incident   Incident?       @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  requestId  String?         @unique
  request    ServiceRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?           @relation(fields: [userId], references: [id])
  score      Int // 1–5
  comment    String?
  createdAt  DateTime        @default(now())
}

// ตัวเลขรวมที่ดีไซน์ระบุแต่ไม่มีรายการรองรับ (เช่น CSAT 812 แบบประเมิน, CI 3,912) ใช้จนกว่าจะมีข้อมูลจริง
model DashboardSnapshot {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

// ประวัติการเปลี่ยนแปลงคอนฟิกูเรชันของ CI
model CIChangeLog {
  id     String            @id @default(cuid())
  ciId   String
  ci     ConfigurationItem @relation(fields: [ciId], references: [id], onDelete: Cascade)
  at     DateTime          @default(now())
  what   String
  source String // เช่น CHG-3381 / Discovery / แก้ไขโดย สมชาย ก.

  @@index([ciId, at])
}

// การอนุมัติ Change โดย CAB / ECAB
model ChangeApproval {
  id         String           @id @default(cuid())
  changeId   String
  change     Change           @relation(fields: [changeId], references: [id], onDelete: Cascade)
  board      String // CAB | ECAB
  approverId String
  approver   User             @relation(fields: [approverId], references: [id])
  decision   ApprovalDecision @default(PENDING)
  comment    String?
  decidedAt  DateTime?
  createdAt  DateTime         @default(now())

  @@unique([changeId, approverId])
}

// บันทึกกิจกรรมของ Problem / Change / Request / KB (ใช้ร่วมกัน)
model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  text       String
  at         DateTime @default(now())

  @@index([entityType, entityId, at])
}

enum EmailStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

enum TokenKind {
  RESET // ลืมรหัสผ่าน / ผู้ดูแลส่งลิงก์รีเซ็ต
  INVITE // เชิญผู้ใช้ใหม่ให้ตั้งรหัสผ่านเอง
}

// คิวอีเมลขาออก: เขียนลง DB ก่อนแล้วค่อยส่ง (ไม่พึ่ง SMTP ในคำขอของผู้ใช้, retry ได้)
// เนื้อหา (text/html) ถูกล้างหลังส่งสำเร็จ เพราะอาจมีลิงก์รีเซ็ตรหัสผ่านที่ยังใช้ได้
model EmailOutbox {
  id            String      @id @default(cuid())
  toEmail       String
  template      String
  subject       String
  text          String?
  html          String?
  critical      Boolean     @default(false) // อีเมลด้านความปลอดภัย — ไม่ผ่านค่าตั้งการแจ้งเตือนของผู้ใช้
  status        EmailStatus @default(PENDING)
  attempts      Int         @default(0)
  nextAttemptAt DateTime    @default(now())
  leasedUntil   DateTime?
  lastError     String?
  dedupeKey     String?     @unique
  createdAt     DateTime    @default(now())
  sentAt        DateTime?

  @@index([status, nextAttemptAt])
  @@index([createdAt])
}

// token ลืมรหัสผ่าน/เชิญผู้ใช้ — เก็บเฉพาะค่าแฮช SHA-256 (อ่าน DB แล้วก็ใช้ลิงก์ไม่ได้), ใช้ได้ครั้งเดียว, มีอายุ
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      TokenKind @default(RESET)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  requestIp String?
  createdAt DateTime  @default(now())

  @@index([userId, usedAt])
}

// แจ้งเตือนในระบบ (กระดิ่ง) — สร้างคู่กับอีเมลแจ้งเตือนงาน ตามค่าตั้งรายหมวดของผู้ใช้เดียวกัน (ไม่รวมอีเมลความปลอดภัยของบัญชี)
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  dedupeKey String?
  createdAt DateTime  @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
}

// กฎมอบหมายอัตโนมัติ: Incident ที่บันทึกผ่าน Service Desk และยังไม่ระบุกลุ่ม/ผู้รับผิดชอบ จะใช้กฎแรกที่ตรงบริการ (กฎที่ไม่ระบุบริการ = ค่าเริ่มต้น)
model AssignmentRule {
  id         String          @id @default(cuid())
  name       String
  serviceId  String?
  service    Service?        @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  groupId    String
  group      AssignmentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  assigneeId String?
  assignee   User?           @relation("RuleAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  active     Boolean         @default(true)
  sortOrder  Int             @default(0)
  createdAt  DateTime        @default(now())

  @@index([active, sortOrder])
}

// ข้อความตอบกลับสำเร็จรูป (macro) — แทรกลงในโน้ตของ Incident ได้ ผู้ใช้เลือกว่าให้ผู้แจ้งเห็นหรือไม่ตอนส่ง
model CannedResponse {
  id        String   @id @default(cuid())
  title     String
  body      String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([active, sortOrder])
}

enum EventSeverity {
  INFO // ข้อมูล (Information)
  WARNING // เตือน (Warning)
  CRITICAL // ผิดปกติ (Exception) — กระทบหรือใกล้กระทบบริการ
}

enum EventStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

// แหล่งเหตุการณ์ (ระบบมอนิเตอร์ภายนอก) — ยืนยันตัวตนด้วย token ที่เก็บเฉพาะแฮช SHA-256 (แสดงครั้งเดียวตอนสร้าง/หมุนเวียน)
model MonitoringSource {
  id           String            @id @default(cuid())
  name         String            @unique
  tokenHash    String            @unique
  active       Boolean           @default(true)
  autoIncident Boolean           @default(true) // CRITICAL → สร้าง Incident อัตโนมัติ
  createdAt    DateTime          @default(now())
  lastEventAt  DateTime?
  events       MonitoringEvent[]
}

// เหตุการณ์จากการเฝ้าระวัง — เหตุการณ์ซ้ำ (แหล่ง + CI + ชื่อการตรวจ) ถูกรวมเป็นรายการเดียวที่นับจำนวนครั้ง
model MonitoringEvent {
  id                  String             @id @default(cuid())
  sourceId            String
  source              MonitoringSource   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  dedupKey            String
  check               String
  ciId                String?
  ci                  ConfigurationItem? @relation(fields: [ciId], references: [id], onDelete: SetNull)
  ciRef               String? // ค่า ci ที่แหล่งส่งมา (เก็บไว้แม้จับคู่ CI ไม่ได้)
  serviceCode         String?
  severity            EventSeverity
  status              EventStatus        @default(OPEN)
  title               String
  message             String?
  firstSeenAt         DateTime           @default(now())
  lastSeenAt          DateTime           @default(now())
  occurrences         Int                @default(1)
  ackedAt             DateTime?
  ackedById           String?
  ackedBy             User?              @relation("EventAckedBy", fields: [ackedById], references: [id], onDelete: SetNull)
  resolvedAt          DateTime?
  resolvedBy          String? // 'auto' (แหล่งแจ้งว่ากลับสู่ปกติ) หรือ id ผู้ใช้
  incidentRequestedAt DateTime? // จองสิทธิ์สร้าง Incident (กันสร้างซ้ำเมื่อมีคำขอพร้อมกัน)
  incidentId          String?
  incident            Incident?          @relation(fields: [incidentId], references: [id], onDelete: SetNull)

  @@index([status, severity])
  @@index([sourceId, dedupKey, status])
  @@index([ciId])
  @@index([lastSeenAt])
}

enum ReleaseStatus {
  PLANNED // วางแผน — กำหนดขอบเขตและแพ็กเกจ Change
  IN_BUILD // กำลังจัดเตรียม/ทดสอบ
  READY // ผ่านเกณฑ์ Go/No-Go พร้อมเปิดใช้
  DEPLOYING // กำลังเปิดใช้งานสู่ production
  DEPLOYED // เปิดใช้งานสำเร็จ
  ROLLED_BACK // ถอยกลับแล้ว
  CANCELLED // ยกเลิก
}

// Release Management (ITIL 4): รวม Change ที่เกี่ยวข้องเป็นรุ่นส่งมอบเดียว วางแผน ตรวจความพร้อม เปิดใช้ และทบทวนหลังเปิดใช้
model Release {
  id           String        @id @default(cuid())
  seq          Int           @unique @default(autoincrement()) // REL-####
  name         String
  version      String?
  description  String?
  status       ReleaseStatus @default(PLANNED)
  ownerId      String?
  owner        User?         @relation("ReleaseOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  serviceId    String?
  service      Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  windowStart  DateTime?
  windowEnd    DateTime?
  deployPlan   String?
  rollbackPlan String?
  review       String? // ทบทวนหลังเปิดใช้ (Post-implementation review)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now()) @updatedAt
  completedAt  DateTime?
  changes      Change[]

  @@index([status])
}

// ค่าตั้งระบบแบบ key/value (JSON) — เช่น เกณฑ์วันแจ้งเตือนประกัน/ไลเซนส์ใกล้หมด (assetAlertDays)
model AppSetting {
  key         String   @id
  value       Json
  updatedAt   DateTime @default(now()) @updatedAt
  updatedById String?
}
